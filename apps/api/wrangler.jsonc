{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "counterfeitiq-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "ANALYZE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "REFERENCE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "GREENBOOK_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ]
}
