# Copy to apps/api/.env, which Git ignores. Never commit real values.
# `wrangler dev` reads that file, and `npm run deploy` uploads it to Cloudflare.

ENVIRONMENT=development

# Workers AI model ID. Without it, analysis returns SERVICE_UNAVAILABLE.
GEMMA_MODEL=@cf/google/gemma-4-26b-a4b-it

# Comma-separated exact origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# demo uses clearly labelled fictional records and contacts nobody.
# authorized_live queries the live NAFDAC Greenbook, and stays off until
# GREENBOOK_ACCESS_BASIS records the basis. See docs/greenbook-access.md.
REFERENCE_MODE=demo
GREENBOOK_ACCESS_BASIS=

# Optional tuning. Delete a line, or leave it invalid, and the code default applies.
MODEL_TIMEOUT_MS=30000
MODEL_MAX_TOKENS=1000
GREENBOOK_TIMEOUT_MS=8000
GREENBOOK_FOUND_TTL_MS=21600000
GREENBOOK_NOT_FOUND_TTL_MS=3600000
