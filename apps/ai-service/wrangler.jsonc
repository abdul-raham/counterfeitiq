{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "counterfeitiq-ai-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "EXTRACT_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
    { "name": "REFERENCE_LIMITER", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
    // Same namespace as apps/api, so the two Workers share one Greenbook budget.
    { "name": "GREENBOOK_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "SCAN_HISTORY", "class_name": "ScanHistory" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScanHistory"] }],
  "vars": {
    "ENVIRONMENT": "production",
    "GEMMA_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "REFERENCE_MODE": "demo",
    "GREENBOOK_ACCESS_BASIS": "",
    "ERP_MODE": "demo",
    "ERP_BASE_URL": ""
  }
}
